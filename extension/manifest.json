{
  "manifest_version": 3,
  "name": "Markin Aviator Capturador",
  "version": "2.0",
  "description": "Captura Aviator em tempo real e envia pro Painel Markin",
  "permissions": ["activeTab", "alarms"],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "wss://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["main-world.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["main-world.js"],
    "matches": ["<all_urls>"]
  }]
}
